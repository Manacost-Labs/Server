#!/usr/bin/env bash
set -euo pipefail
root=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

usage() {
  printf '%s\n' \
    'Usage: codex-run {luna|terra} [minimal|code|web|research|github|infra|typeui] [codex arguments...]' \
    '       codex-run {sol|astra} --reason TEXT --package PATH [minimal|code|web|research|github|infra|typeui] [codex arguments...]' >&2
}

model=${1:-}
shift || true
case "$model" in
  luna) model_id='gpt-5.6-luna' ;;
  terra) model_id='gpt-5.6-terra' ;;
  sol) model_id='gpt-5.6-sol' ;;
  astra) model_id='gpt-6-astra' ;;
  *) usage; exit 2 ;;
esac

reason=''
package=''
if [[ $model == sol || $model == astra ]]; then
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason=${2:-}; shift 2 ;;
      --package) package=${2:-}; shift 2 ;;
      *) break ;;
    esac
  done
  [[ ${#reason} -ge 12 ]] || {
    printf '%s\n' 'codex-run: senior model requires a specific --reason' >&2
    exit 2
  }
  [[ -f $package ]] || {
    printf '%s\n' 'codex-run: senior model requires one bounded --package file' >&2
    exit 2
  }
  bash "$root/context-budget" --model "$model_id" "$package" >/dev/null
fi

profile=${1:-minimal}
case "$profile" in
  minimal|code|web|research|github|infra|typeui) shift || true ;;
  *) usage; exit 2 ;;
esac
for argument in "$@"; do
  case "$argument" in
    -m|--model|--model=*|-m?*)
      printf '%s\n' 'codex-run: model overrides bypass the manual gate; select the model as the first argument' >&2
      exit 2 ;;
  esac
done
exec bash "$root/codex-context" "$profile" -m "$model_id" "$@"
