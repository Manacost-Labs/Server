#!/usr/bin/env bash
set -euo pipefail

limit=12000
if [[ ${1:-} == --limit ]]; then
  [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || {
    printf '%s\n' 'context-budget: --limit must be a positive integer' >&2
    exit 2
  }
  limit=$2
  shift 2
fi
if [[ $# -eq 0 ]]; then
  printf '%s\n' 'Usage: context-budget [--limit TOKENS] FILE_OR_DIRECTORY [...]' >&2
  exit 2
fi
command -v tiktoken-cli >/dev/null || {
  printf '%s\n' 'context-budget: tiktoken-cli is not installed' >&2
  exit 127
}

output=$(tiktoken-cli --model gpt-4o "$@")
printf '%s\n' "$output"
tokens=$(printf '%s\n' "$output" | awk '/^[[:space:]]*[0-9]+[[:space:]]/ { value=$1 } END { print value }')
[[ $tokens =~ ^[0-9]+$ ]] || {
  printf '%s\n' 'context-budget: unable to parse token estimate' >&2
  exit 1
}

if (( tokens > limit )); then
  printf 'CONTEXT BUDGET: EXCEEDED — estimated %s tokens; limit %s. Narrow files, use a checkpoint, or start a new task.\n' "$tokens" "$limit" >&2
  exit 3
fi
printf 'CONTEXT BUDGET: OK — estimated %s / %s tokens.\n' "$tokens" "$limit"
