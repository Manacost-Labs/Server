#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
inventory="$repo_root/inventory/skills.tsv"

usage() {
  cat <<'EOF'
Usage:
  skillctl list <profile>       List available skills (does not activate them)
  skillctl resolve <skill-id>   Print the canonical SKILL.md path
  skillctl show <skill-id>      Print metadata and the canonical SKILL.md
  skillctl plan <project-root>  Show a read-only migration plan
  skillctl audit <project-root> Compare local skills with the catalog
  skillctl check-response       Validate a concise agent handoff
  skillctl check                Validate the catalog
  skillctl route <root> --task TEXT [--complexity trivial|normal|complex]
  skillctl risk <root> [--risk LOW|MEDIUM|HIGH|CRITICAL]
  skillctl models               Resolve model roles (does not probe availability)
  skillctl dispatch <root> --task TEXT [--capabilities FILE]  Print model stages
  skillctl validate-routing-policy  Validate bounded runtime model policy
  skillctl verify <root> [--dry-run] [--base REVISION]
  skillctl validate-policy      Validate executable engineering policy
  skillctl validate-brief FILE  Validate compact Context Brief JSON
  skillctl scope-init FILE --project ROOT --owner ID --allow GLOB
  skillctl guard-diff FILE [--pre-edit]  Validate scope and checkpoint drift
  skillctl scope-checkpoint FILE
  skillctl scope-close FILE
EOF
}

fail() {
  printf 'skillctl: %s\n' "$1" >&2
  exit 1
}

profile_file() {
  local profile=$1
  [[ "$profile" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid profile: $profile"
  local file="$repo_root/profiles/$profile.yaml"
  [[ -f "$file" ]] || fail "unknown profile: $profile"
  printf '%s\n' "$file"
}

inventory_path() {
  local skill_id=$1
  local path
  path=$(awk -F '\t' -v wanted="$skill_id" 'NR > 1 && $1 == wanted {print $3; exit}' "$inventory")
  [[ -n "$path" ]] || fail "unknown skill id: $skill_id"
  [[ -f "$repo_root/$path" ]] || fail "canonical file is missing: $path"
  printf '%s\n' "$path"
}

print_profile_skills() {
  local file=$1
  while IFS= read -r skill_id; do
    [[ -z "$skill_id" ]] && continue
    printf '  %s\t%s\n' "$skill_id" "$(inventory_path "$skill_id")"
  done < <(awk '/^available:/{active=1; next} /^[^[:space:]]/{active=0} active && /^  - [^\/]+\/[^[:space:]]+$/{print $2}' "$file")
}

list_profile() {
  local profile=$1
  local file
  file=$(profile_file "$profile")
  printf 'profile: %s\n' "$profile"
  printf 'skills:\n'
  print_profile_skills "$file"
  while IFS= read -r included_profile; do
    [[ -z "$included_profile" ]] && continue
    printf 'included_profile: %s\n' "$included_profile"
    print_profile_skills "$(profile_file "$included_profile")"
  done < <(awk '/^include:/{active=1; next} /^[^[:space:]]/{active=0} active && /^  - [a-z0-9][a-z0-9-]*$/{print $2}' "$file")
}

show_skill() {
  local skill_id=$1
  local path
  path=$(inventory_path "$skill_id")
  printf 'id: %s\n' "$skill_id"
  sed -n '1,20p' "$repo_root/${path%/SKILL.md}/skill.yaml"
  printf '\n--- SKILL.md ---\n'
  cat "$repo_root/$path"
}

detect_profile() {
  local project_root=$1
  case "$project_root" in
    */work.kolodahearthstone.com|*/work-koloda-data-control-6h*) printf 'openbot\n' ;;
    */IceCrow|*/icecrow-*) printf 'icecrow
' ;;
    */HeartPulse|*/heartpulse-*|*/arena.hs-manacost.ru*) printf 'hearthpulse\n' ;;
    */wordpress/*|*hs-manacost*|*kolodahearthstone*) printf 'wordpress\n' ;;
    */ParsesUnix|*/data/*|*/api-*) printf 'data\n' ;;
    *) printf 'server\n' ;;
  esac
}

plan_project() {
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  local project_root
  project_root=$(cd -- "$1" 2>/dev/null && pwd) || fail "project directory is missing: $1"
  local profile
  profile=$(detect_profile "$project_root")
  local legacy_count=0
  local loader
  for loader in .agents/skills .claude/skills .codex/skills; do
    if [[ -d "$project_root/$loader" ]]; then
      local loader_count
      loader_count=$(rg --files --hidden -g 'SKILL.md' "$project_root/$loader" 2>/dev/null | wc -l || true)
      legacy_count=$((legacy_count + loader_count))
    fi
  done
  local worktree=not-a-git-worktree
  if git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    worktree=clean
    [[ -n "$(git -C "$project_root" status --short)" ]] && worktree=changed
  fi
  printf 'project: %s\nprofile: %s\nworktree: %s\nlegacy_skill_files: %s\nmigration: dry-run\n' \
    "$project_root" "$profile" "$worktree" "$legacy_count"
  printf 'next:\n  - review profiles/%s.yaml\n  - compare local skill hashes with inventory/sources.tsv\n  - switch only after the project quality gate passes\n' "$profile"
}

audit_project() {
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  local project_root
  project_root=$(cd -- "$1" 2>/dev/null && pwd) || fail "project directory is missing: $1"
  local profile
  profile=$(detect_profile "$project_root")
  local canonical_matches=0
  local known_sources=0
  local drifted=0
  local unmapped=0
  printf 'project: %s\nprofile: %s\nlegacy:\n' "$project_root" "$profile"
  local loader local_file relative_path local_name hash matched_id canonical_path canonical_hash status
  for loader in .agents/skills .claude/skills .codex/skills; do
    [[ -d "$project_root/$loader" ]] || continue
    while IFS= read -r local_file; do
      relative_path=${local_file#"$project_root"/}
      local_name=$(basename -- "$(dirname -- "$local_file")")
      hash=$(sha256sum "$local_file" | awk '{print $1}')
      matched_id=$(awk -F '\t' -v wanted="$hash" 'NR > 1 && $3 == wanted {print $1; exit}' "$repo_root/inventory/sources.tsv")
      status=''
      if [[ -n "$matched_id" ]]; then
        canonical_path=$(inventory_path "$matched_id")
        canonical_hash=$(sha256sum "$repo_root/$canonical_path" | awk '{print $1}')
        if [[ "$hash" == "$canonical_hash" ]]; then
          status=canonical
          canonical_matches=$((canonical_matches + 1))
        else
          status=known-source
          known_sources=$((known_sources + 1))
        fi
      else
        matched_id=$(awk -F '\t' -v wanted="$local_name" 'NR > 1 {n=split($3, parts, "/"); if (parts[n-1] == wanted) {print $1; exit}}' "$inventory")
        if [[ -n "$matched_id" ]]; then
          status=drifted
          drifted=$((drifted + 1))
        else
          status=unmapped
          unmapped=$((unmapped + 1))
        fi
      fi
      printf '  %s\t%s\t%s\n' "$relative_path" "$status" "${matched_id:--}"
    done < <(rg --files --hidden -g 'SKILL.md' "$project_root/$loader" 2>/dev/null | sort)
  done
  printf 'summary:\n  canonical: %s\n  known-source: %s\n  drifted: %s\n  unmapped: %s\n' \
    "$canonical_matches" "$known_sources" "$drifted" "$unmapped"
}

command_name=${1:-}
case "$command_name" in
  dispatch)
    shift
    exec python3 "$repo_root/scripts/model_routing.py" "$@"
    ;;
  validate-routing-policy)
    shift
    exec python3 "$repo_root/scripts/model_routing.py" --validate-policy "$@"
    ;;
  route|risk|models|verify|validate-policy|validate-brief)
    exec python3 "$repo_root/scripts/engineering.py" "$@"
    ;;
  scope-init|guard-diff|scope-checkpoint|scope-close)
    exec python3 "$repo_root/scripts/scope_guard.py" "$@"
    ;;
  list)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    list_profile "$2"
    ;;
  resolve)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    resolved_path=$(inventory_path "$2")
    printf '%s\n' "$repo_root/$resolved_path"
    ;;
  show)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    show_skill "$2"
    ;;
  plan)
    plan_project "$2"
    ;;
  audit)
    audit_project "$2"
    ;;
  check-response)
    shift
    exec "$repo_root/scripts/check-agent-response" "$@"
    ;;
  check)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    "$repo_root/scripts/validate-registry.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
